# Telegram
BOT_TOKEN=123456:ABC-DEF...
BOOTSTRAP_ADMIN_IDS=123456789,987654321

# Database (use a URL-safe secret; do not commit the real .env file)
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://classmate:replace-with-a-long-random-secret@localhost:5432/classmate

# Redis (required for production FSM; optional for local MemoryStorage)
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
